#!/usr/bin/env bash
set -euo pipefail
umask 077

if [[ $EUID != 0 || ! -t 0 ]]; then
  printf '%s\n' 'Запусти эту команду от root в терминале.'
  exit 1
fi

status=$(curl -fsS --max-time 5 http://127.0.0.1:8081/api/voting/status)
if [[ $status == *'"state":"open"'* ]]; then
  printf '%s\n' 'Смени пароль после закрытия голосования.'
  exit 1
fi

read -rsp 'Новый пароль админки (от 15 символов): ' password
printf '\n'
read -rsp 'Повтори новый пароль: ' repeated
printf '\n'
if [[ $password != "$repeated" ]]; then
  printf '%s\n' 'Пароли не совпали.'
  exit 1
fi
hash=$(printf '%s\n' "$password" | /opt/megalove/megalove admin-hash)
unset password repeated

settings=/etc/megalove.env
next=$(mktemp /etc/.megalove-env.XXXXXX)
trap 'rm -f "$next"' EXIT
while IFS= read -r line || [[ -n $line ]]; do
  if [[ $line != MEGALOVE_ADMIN_HASH=* ]]; then
    printf '%s\n' "$line"
  fi
done < "$settings" > "$next"
printf 'MEGALOVE_ADMIN_HASH=%s\n' "$hash" >> "$next"
mv -f "$next" "$settings"
systemctl restart megalove
for attempt in {1..10}; do
  if curl -fsS --max-time 2 -o /dev/null http://127.0.0.1:8081/healthz 2>/dev/null; then
    printf '%s\n' 'Пароль обновлён. Войди на https://vote.megabattle.site/admin'
    exit 0
  fi
  sleep 1
done
printf '%s\n' 'Пароль записан, но сервис не ответил. Проверь systemctl status megalove.'
exit 1
